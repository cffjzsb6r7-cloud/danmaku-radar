# 邮件推送（SMTP）—— GitHub Actions Secrets 或 Render 环境变量
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@qq.com
SMTP_PASS=你的授权码
SMTP_FROM=you@qq.com

# 可选：CORS 白名单（默认 *）
DANMAKU_CORS=*
# 可选：数据库文件路径（默认 data/danmaku.db）
DANMAKU_DB=data/danmaku.db

# 单域名 Docker/Render 部署时让 FastAPI 同时托管 website/；GitHub Pages 保持 false
DANMAKU_SERVE_WEB=false
# 保护 POST /api/refresh，留空表示由 GitHub Actions 内部调用
DANMAKU_REFRESH_TOKEN=
DANMAKU_STALE_HOURS=48
